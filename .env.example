# BusinessMind Configuration Template
# Copy this file to .env and configure your environment variables

# AI Business Insights API Configuration (Optional)
# Leave as placeholder or blank to use built-in local heuristic fallback
GEMINI_API_KEY=your_gemini_api_key_here

# Model Identifiers for Google Generative Language API
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Server Configuration
PORT=5000
FLASK_ENV=development
FLASK_DEBUG=0
